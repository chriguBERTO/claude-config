{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DEFAULT_EFFORT": "high"
  },
  "permissions": {
    "deny": [
      "Bash(*infisical *)",
      "Read(//**/.infisical/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccstatusline@latest"
  },
  "tui": "fullscreen",
  "theme": "dark"
}
