{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DEFAULT_EFFORT": "medium"
  },
  "permissions": {
    "allow": [
      "Bash(git mv *)",
      "Bash(git add *)"
    ],
    "deny": [
      "Bash(*infisical *)",
      "Read(//**/.infisical/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials*)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "npx ccstatusline@latest"
  },
  "effortLevel": "xhigh"
}
